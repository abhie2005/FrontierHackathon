    {
      "id": "falkordb_writeback",
      "provider": "tool_falkordb",
      "config": {
        "type": "tool_falkordb",
        "host": "localhost",
        "port": 6379,
        "tls": false,
        "graph": "warehouse",
        "allow_writes": true,
        "max_rows": 250,
        "query_timeout_ms": 30000
      },
      "ui": {
        "position": {
          "x": 450,
