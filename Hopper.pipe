        },
        "measured": {
          "width": 160,
          "height": 80
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "guild_negotiation",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "Coordinates negotiation between Risk Agent and Mode Agent",
        "instructions": [
          "Risk Agent assesses stockout gap: days_of_stock_left = current_stock / (effective_weekly_demand / 7).",
          "Mode Agent compares cost-vs-urgency of modes (rail, truck, air).",
          "RocketRide executes final mode-switch decision and writes back to graph memory."
        ],
        "max_waves": 10
      },
      "input": [
        {
          "lane": "questions",
          "from": "laserdata_trigger"
        }
      ],
      "control": [
        {
          "classType": "llm",
          "from": "llm_1"
        },
        {
          "classType": "memory",
          "from": "memory_1"
        },
        {
          "classType": "tool",
          "from": "falkordb_context_pull"
        },
        {
          "classType": "tool",
          "from": "rocketride_execution"
        },
        {
          "classType": "tool",
          "from": "falkordb_writeback"
        }
      ],
      "ui": {
        "position": {
          "x": 650,
          "y": 150
        },
        "measured": {
          "width": 160,
          "height": 80
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_1",
      "provider": "response_answers",
      "config": {
        "type": "response_answers",
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "guild_negotiation"
        }
      ],
      "ui": {
        "position": {
          "x": 850,
          "y": 150
        },
        "measured": {
          "width": 160,
          "height": 80
        },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
