# FalkorDB connection.
# LOCAL DOCKER (default): docker run -p 6379:6379 -it falkordb/falkordb:latest
# FALKORDB CLOUD: copy the connection details from your free instance dashboard.
#
# NOTE: pipeline.pipe runs on the RocketRide runtime, so the runtime has to be
# able to reach this host. `localhost` only works with a self-hosted engine —
# for the hosted runtime at api.rocketride.ai, point these at FalkorDB Cloud.
# These values are mirrored into the ROCKETRIDE_FALKORDB_* variables the
# pipeline substitutes, so configure them here only.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=warehouse
FALKORDB_TLS=false

# RocketRide. With an API key set, `runPipeline` executes pipeline.pipe on the
# RocketRide runtime: Mode Agent + Risk Agent + the FalkorDB read/write tools all
# run there. Leave it empty (or set ROCKETRIDE_PIPELINE=0) to fall back to the
# local threshold agents in src/agents/. Verify with `npm run check:rocketride`.
ROCKETRIDE_API_KEY=
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_PIPELINE=1

# LaserData — real-time signal layer (Apache Iggy transport).
# Get a free connection string from https://laserdata.cloud (no credit card).
# Format is bare user:password@host:port, e.g. iggy:iggy@your-host.laserdata.cloud:8090
LASER_CONNECTION_STRING=
LASER_STREAM=hopper

# Anthropic API key — powers the llm_anthropic node inside pipeline.pipe (and the
# optional LLM-generated rationale when LLM_RATIONALE=1). Mirrored into
# ROCKETRIDE_ANTHROPIC_KEY. The local threshold path works fully without it.
ANTHROPIC_API_KEY=
LLM_RATIONALE=0
