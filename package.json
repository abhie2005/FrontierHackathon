{
  "name": "warehouse-memory-network",
  "version": "1.0.0",
  "description": "Adaptive mode selection network — FalkorDB memory + Guild.ai agents + RocketRide execution over a live flu-outbreak signal.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "tsx src/falkordb/seed.ts",
    "seed:hubs": "tsx src/falkordb/seed-per-hub.ts",
    "query": "tsx src/falkordb/demo-query.ts",
    "agents": "tsx src/agents/pipeline.ts",
    "pipeline": "tsx src/run.ts",
    "demo": "tsx src/run-demo.ts",
    "ui": "node server.cjs",
    "server": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "falkordb": "^6.7.0",
    "rocketride": "^1.3.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
